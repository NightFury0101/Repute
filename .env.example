# Postgres connection string. A free database from Neon (neon.tech) or Prisma
# Postgres (console.prisma.io) works fine, or point this at a local instance.
DATABASE_URL="postgresql://user:password@localhost:5432/repute"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Required by `npm run db:seed` to create the initial admin account. There is
# no built-in default password — the seed script refuses to run without a
# real value here (and rejects "change-me-before-seeding" literally, so you
# can't accidentally seed with this placeholder). Pick your own password.
ADMIN_SEED_EMAIL="admin@repute.com"
ADMIN_SEED_PASSWORD="change-me-before-seeding"

# Required by `npm run db:seed` to create a demo customer account. Same rule
# as above — choose your own password before seeding.
CUSTOMER_SEED_EMAIL="customer@repute.com"
CUSTOMER_SEED_PASSWORD="change-me-before-seeding"

# Dev-only convenience: shows the seed email + which env var holds the
# password directly on the login screens. Leave unset (or "false") in any
# shared/production environment.
# NEXT_PUBLIC_SHOW_DEMO_HINTS="true"

# --- Optional: real payment provider (not yet wired up, see checkout flow) ---
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
